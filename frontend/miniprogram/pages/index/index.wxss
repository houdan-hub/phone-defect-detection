/* container 全局样式 */
.container {
  padding: 40rpx;
  background-color: #f7f8fa;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  display: block;
  text-align: center;
}

/* 价格输入区域 */
.price-input-section {
  width: 100%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.25);
}
.price-label {
  display: block;
  font-size: 26rpx;
  color: #ffffff;
  margin-bottom: 16rpx;
  font-weight: 500;
}
.input-field {
  width: 100%;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  color: #333;
}

/* 按钮网格 */
.btn-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  width: 100%;
  margin-bottom: 50rpx;
}
.view-btn {
  width: 48% !important;
  background-color: #ffffff;
  color: #555;
  border-radius: 16rpx;
  font-size: 28rpx;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
  border: 1px solid #e0e0e0;
}

/* 图片预览与水印 */
.image-preview {
  position: relative;
  width: 100%;
  height: 450rpx;
  background: #000;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
}
.view-tag-overlay {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  background: rgba(7, 193, 96, 0.85);
  color: white;
  padding: 6rpx 20rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
  z-index: 10;
  font-weight: bold;
}
.preview-img {
  width: 100%;
  height: 100%;
}

.grade-btn {
  width: 100%;
  margin-top: 30rpx;
  padding: 24rpx 0;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 16rpx;
}

/* 报告容器 */
.report-container {
  margin: 30rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
  padding: 40rpx 30rpx;
  width: calc(100% - 60rpx);
}

.score-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}
.score-text {
  font-size: 80rpx;
  font-weight: bold;
  color: #07c160;
}
.grade-badge {
  background: #f0f9f4;
  color: #07c160;
  padding: 8rpx 30rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  margin-top: 10rpx;
}

.price-box {
  background: #fff8f0;
  border: 1px solid #ffe8cc;
  border-radius: 16rpx;
  padding: 30rpx;
  text-align: center;
  margin-bottom: 40rpx;
}
.price-title { font-size: 26rpx; color: #fa8c16; display: block; margin-bottom: 10rpx; }
.price-value { font-size: 50rpx; font-weight: bold; color: #ff4d4f; display: block; margin-bottom: 10rpx; }
.price-desc { font-size: 22rpx; color: #8c8c8c; }

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}
.scroll-view {
  white-space: nowrap;
  width: 100%;
  padding-bottom: 20rpx;
}

/* 瑕疵卡片优化 */
.defect-card {
  display: inline-block;
  width: 320rpx;
  background: #f8f9fa;
  border-left: 8rpx solid #ff4d4f;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-right: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);
}
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}
.card-tag {
  font-size: 22rpx;
  color: #fff;
  background: #8c8c8c;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}
.card-pos-text {
  font-size: 20rpx;
  color: #999;
}
.card-type {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}
.card-desc {
  font-size: 24rpx;
  color: #666;
  white-space: normal;
  height: 64rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}
.card-tip {
  font-size: 22rpx;
  color: #667eea;
  margin-bottom: 12rpx;
}
.card-deduct {
  font-size: 24rpx;
  color: #ff4d4f;
  font-weight: bold;
}

.algo-box {
  margin-top: 40rpx;
  background: #f6f6f6;
  border-radius: 12rpx;
  padding: 20rpx;
}
.algo-title { font-size: 26rpx; color: #576b95; text-align: center; }
.algo-content { margin-top: 20rpx; border-top: 1px dashed #ccc; padding-top: 20rpx; }
.algo-text { display: block; font-size: 22rpx; color: #888; line-height: 1.8; }
