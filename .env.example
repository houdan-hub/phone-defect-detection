# ============================================================
# Backend Configuration
# ============================================================

# Path to the trained ONNX model (relative to backend/ directory)
MODEL_PATH=models/best.onnx

# Directory for saving detection result images
SAVE_DIR=results

# Maximum age of result images before cleanup (hours)
MAX_FILE_AGE_HOURS=24

# Server host & port
HOST=0.0.0.0
PORT=8000

